# Copy this file to `.env` (which is gitignored) and fill in real values.
#
#   cp .env.example .env
#   docker compose up --build
#
# Without these, the app boots but the playground talks to a deterministic
# stub LLM and the deterministic-hash embedding stub — useful for testing
# the engine, useless for real grounded answers.

# Anthropic API key for the chat LLM (claude-sonnet-4-6 by default).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key for embeddings (text-embedding-3-small).
# Only needed when YAYA_EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=

# Which embedding provider to wire. `openai` uses the real model
# (text-embedding-3-small); set to `none` to fall back to the
# deterministic-hash stub for offline / no-key dev.
YAYA_EMBEDDING_PROVIDER=openai

# Which chat LLM client to wire:
#   anthropic  — Claude (requires ANTHROPIC_API_KEY)
#   openai     — GPT-4o-mini by default (requires OPENAI_API_KEY)
#   stub       — deterministic pattern-matching client, offline/no-key dev
YAYA_LLM_PROVIDER=anthropic

# Optional: override the OpenAI chat model when YAYA_LLM_PROVIDER=openai.
# OPENAI_CHAT_MODEL=gpt-4o

# Dev convenience: allow anonymous sessions on /v1/sessions/*. Production
# MUST set this to false and wire a real Authenticator (M5).
YAYA_AUTH_ALLOW_ANONYMOUS=true

# Master key for AES-256-GCM encryption of credentials at rest (currently
# used by SharedSecretJwtAuthenticator for per-tenant HMAC keys stored in
# tenant_jwt_secrets). Generate with `openssl rand -base64 32` — must
# decode to exactly 32 bytes. Leave blank to disable HS256 admin writes;
# OIDC issuers and identity-routing both work without it.
# YAYA_AGENTIC_SECRETS_ENCRYPTION_KEY=

# Comma-separated list of origins allowed to call /v1/* from the browser.
# Wildcard patterns supported — bound via CorsConfiguration.setAllowedOriginPatterns
# so they work alongside allowCredentials=true. Local defaults below cover
# compose-on-host and flutter run -d chrome; add the public SPA origin(s)
# for each deployment, e.g.
#   YAYA_AGENTIC_CORS_ALLOWED_ORIGINS=http://localhost:*,https://admin.example.com
YAYA_AGENTIC_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Postgres credentials — defaults are throwaway values for the localhost
# dev stack (port 5433, not exposed publicly). OVERRIDE BEFORE EXPOSING
# THIS STACK ON ANY NON-LOOPBACK INTERFACE.
POSTGRES_DB=yaya_agentic
POSTGRES_USER=yaya
POSTGRES_PASSWORD=yaya

# Override only if your Flutter web container needs to reach the backend
# under a different name (e.g. when fronting both behind a reverse proxy).
# BACKEND_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Chat web app deep link (yayaagenticchat)
# ---------------------------------------------------------------------------
# Prefix the chat QR / share link is built from: this value + the entry-point
# handle (e.g. https://chat.example.com/e/e_abc123). It MUST point at the
# public origin that SERVES THE CHAT WEB APP — which is independent of this
# backend's own URL and changes per deployment. Leave the localhost default
# for dev; set it per environment in prod. Trailing slash required.
# YAYA_CHAT_DEEP_LINK_BASE=https://chat.example.com/e/

# ---------------------------------------------------------------------------
# Twilio — phone verification (chat §20), SMS, and WhatsApp
# ---------------------------------------------------------------------------
# One platform-singleton Twilio account backs all three channels. Leave every
# value blank and the channels disable themselves (the app still boots; chat
# OTP falls back to a dev no-op verifier where any code passes). Fill them in
# to send real OTP / SMS / WhatsApp.
#
# Console: https://console.twilio.com → Account → API keys & tokens.

# Twilio Account SID (starts with `AC`). Identifies the account on every API
# call and in the Messages endpoint path. Required to wire any Twilio channel.
TWILIO_ACCOUNT_SID=

# Standard API Key SID (`SK`) + its secret. Twilio's recommended auth pair for
# outbound API calls and for Verify (preferred over the raw Auth Token). Create
# under API keys & tokens → Create API key; the secret is shown only once.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Account Auth Token. Two jobs: (1) Twilio signs inbound webhooks with it
# (X-Twilio-Signature) so the SMS/WhatsApp webhook controllers can verify the
# call really came from Twilio; (2) it's the Verify auth fallback when no API
# key pair is set. Needed once you accept inbound SMS/WhatsApp.
TWILIO_AUTH_TOKEN=

# Verify Service SID (`VA`). THIS IS THE ON SWITCH for real chat phone
# verification — present = real Twilio OTP, absent = dev no-op verifier.
# Create under Verify → Services. Note the relaxed-binding name: it is set
# ONLY via this env var (never given a blank default in application.yml, since
# an empty value would switch the real verifier on with no SID — see the yml
# comment). Leave unset in dev.
# YAYA_AGENTIC_CHAT_VERIFY_TWILIO_SERVICE_SID=VA...

# Public host Twilio dials back into for inbound messages + delivery-status
# callbacks. Must be reachable from the internet (e.g. an ngrok URL in dev, the
# real domain in prod). Blank → falls back to YAYA_PUBLIC_BASE_URL.
TWILIO_WEBHOOK_BASE_URL=

# Optional Messaging Service SID (`MG`). When set, outbound SMS/WhatsApp go
# through the Messaging Service (number pooling, sticky-sender) instead of a
# single From number. Leave blank to send from a plain number.
TWILIO_MESSAGING_SERVICE_SID=

# A2P 10DLC registration bundles — only needed to register US SMS brands /
# campaigns (TwilioA2pRegistrar). Created during A2P onboarding in the console.
# TWILIO_A2P_CUSTOMER_PROFILE_BUNDLE_SID=BU...
# TWILIO_A2P_PROFILE_BUNDLE_SID=
