# yaya-identity deployment configuration.
# Copy to `.env` and fill the secrets — or run `./deploy.sh` which generates them.

# --- Public URL the browser uses (console + API, same origin via nginx) ---
# Production: served under /identity on the existing agent host.
PUBLIC_ORIGIN=https://yayaagentic.smartlottery.do/identity
IDENTITY_BASE_PATH=/identity
# Local dev without a domain, use these instead (root of its own origin):
#PUBLIC_ORIGIN=http://localhost:8091
#IDENTITY_BASE_PATH=

# --- Database ---
IDENTITY_DB_NAME=yaya_identity
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=            # required — generate: openssl rand -base64 24

# --- Root of trust (REQUIRED) ---
# base64-encoded 32-byte AES-256 key. Encrypts signing keys + TOTP seeds at rest.
# Generate: openssl rand -base64 32
YAYA_IDENTITY_SECRETS_ENCRYPTION_KEY=

# --- Service client (yaya-agentic / other apps use client-credentials) ---
# Generate: openssl rand -base64 24
YAYA_IDENTITY_BOOTSTRAP_SERVICE_CLIENT_SECRET=

# --- First-access master user (create the console login) ---
# Password MUST be at least 12 characters.
YAYA_IDENTITY_BOOTSTRAP_OWNER_EMAIL=owner@example.com
YAYA_IDENTITY_BOOTSTRAP_OWNER_PASSWORD=
YAYA_IDENTITY_BOOTSTRAP_OWNER_ORG=Root Org
