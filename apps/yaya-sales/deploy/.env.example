# yaya-sales deployment configuration.
# Copy to `.env` and fill the secrets — or run `./deploy.sh` which generates them.

# --- Host port the backend is published on (container always listens on 8092) ---
SALES_PORT=8092

# --- Database ---
SALES_DB_NAME=yaya_sales
SALES_DB_USER=sales
SALES_DB_PASSWORD=            # required — generate: openssl rand -base64 24

# --- Root of trust (REQUIRED) ---
# base64-encoded 32-byte AES-256 key. Encrypts PSP/carrier credentials and
# courier KYC documents at rest (design §15).
# Generate: openssl rand -base64 32
YAYA_SALES_SECRETS_ENCRYPTION_KEY=

# --- Operator / shopper JWT trust ---
# OIDC issuer whose JWTs authenticate operators (admin API) and forwarded
# shopper principals — the same issuer yaya-agentic trusts, e.g. your
# yaya-identity deployment. Blank = JWT auth off (service tokens only).
YAYA_SALES_AUTH_ISSUER_URI=

# --- Agent trust wiring (service token) ---
# The tenant this deployment serves, and the shared HMAC secret verifying
# X-Yaya-Service-Token minted by yaya-agentic. The SAME secret must be set on
# the agent side as `yaya.agentic.auth.service-token.tenant-secrets.<tenantId>`
# (see docs/RUNBOOK.md step 2). Generate: openssl rand -base64 32
# Multi-tenant deployments: edit SPRING_APPLICATION_JSON in compose.yaml or
# override it from .env.local with the full service-secrets map.
SALES_TENANT_ID=default
SALES_SERVICE_TOKEN_SECRET=

# --- Payments ---
# HMAC secret for the sandbox PSP webhook (X-Sandbox-Signature on
# POST /v1/sales/webhooks/sandbox). Generate: openssl rand -base64 24
YAYA_SALES_PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# Live PSP keys do NOT go here — put them in git-ignored `.env.local`
# (passed straight into the container). Available keys:
#   YAYA_SALES_PAYMENTS_STRIPE_SECRET_KEY=sk_live_…
#   YAYA_SALES_PAYMENTS_STRIPE_PUBLISHABLE_KEY=pk_…
#   YAYA_SALES_PAYMENTS_STRIPE_WEBHOOK_SIGNING_SECRET=whsec_…
#   YAYA_SALES_PAYMENTS_PAYPAL_CLIENT_ID=…
#   YAYA_SALES_PAYMENTS_PAYPAL_CLIENT_SECRET=…
#   YAYA_SALES_PAYMENTS_PAYPAL_WEBHOOK_ID=…
#   YAYA_SALES_PAYMENTS_DLOCAL_X_LOGIN=…
#   YAYA_SALES_PAYMENTS_DLOCAL_TRANS_KEY=…
#   YAYA_SALES_PAYMENTS_DLOCAL_SECRET_KEY=…
#   YAYA_SALES_PAYMENTS_DEFAULT_PROVIDER=sandbox
# .env.local is also the pass-through for anything added later (e.g.
# yaya.sales.notifications.* knobs → YAYA_SALES_NOTIFICATIONS_…).

# --- Background machinery (defaults mirror application.yml) ---
#SALES_OUTBOX_POLL_ENABLED=true
#SALES_OUTBOX_POLL_INTERVAL_MS=2000
#SALES_INVENTORY_SWEEP_ENABLED=true
#SALES_INVENTORY_SWEEP_INTERVAL_MS=30000

# --- Courier fleet (design §8.9) ---
# otp-echo returns the registration OTP in the API response — DEV/TEST ONLY.
#SALES_DELIVERY_OTP_ECHO_ENABLED=false
#SALES_DELIVERY_OTP_TTL_MINUTES=10
#SALES_DELIVERY_INVITE_TTL_HOURS=72

# --- Console (SPA origins; also set these CORS knobs) ---
IDENTITY_BASE_URL=http://localhost:8090
SALES_PUBLIC_URL=http://localhost:8092
CONSOLE_PUBLIC_URL=http://localhost:8093
CONSOLE_CLIENT_ID=yaya-console
CONSOLE_PORT=8093
# yaya-sales must allow the console origin:
YAYA_SALES_CORS_ALLOWED_ORIGINS=http://localhost:8093
# and the identity stack needs: YAYA_IDENTITY_CORS_ALLOWED_ORIGINS=http://localhost:8093

# --- Admin-plane tenant binding (on by default) ---
# The operator JWT claim whose value must equal the store's tenant id.
# yaya-identity mints `org`; if your org ids differ from the agent tenant ids,
# either use the org id AS the tenant id everywhere, or mint a custom claim
# and name it here. Disable only for single-merchant deployments.
YAYA_SALES_OPERATOR_TENANT_CLAIM=org
YAYA_SALES_ENFORCE_OPERATOR_TENANT=true
