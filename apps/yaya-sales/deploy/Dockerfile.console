# yaya-sales admin console — Flutter web build served by nginx.
# Build context: apps/yaya-sales/  (reads console/ and deploy/nginx.conf.template)
#
# nginx here is a same-origin front: it serves the SPA AND proxies
# ${SALES_BASE_PATH}/v1/ + /actuator/ to the backend (which runs with servlet
# context-path = $SALES_BASE_PATH). Root deploys keep SALES_BASE_PATH empty.
# Cross-origin identity is still possible — list the console origin in
# YAYA_IDENTITY_CORS_ALLOWED_ORIGINS unless identity shares the same host.
FROM ghcr.io/cirruslabs/flutter:3.41.1 AS build
WORKDIR /app
COPY console/pubspec.yaml console/pubspec.lock ./
RUN flutter pub get
COPY console/ ./
ARG IDENTITY_BASE_URL
ARG SALES_API_BASE_URL
ARG CONSOLE_CLIENT_ID=yaya-console
ARG CONSOLE_REDIRECT_URI
# Subpath prefix ('' for root, '/sales' for the subpath deploy).
ARG SALES_BASE_PATH=
# base-href must be "<prefix>/" — "/" at root, "/sales/" under a subpath.
RUN flutter build web --release --pwa-strategy=none --base-href "${SALES_BASE_PATH}/" \
    --dart-define=IDENTITY_BASE_URL=${IDENTITY_BASE_URL} \
    --dart-define=SALES_API_BASE_URL=${SALES_API_BASE_URL} \
    --dart-define=CONSOLE_CLIENT_ID=${CONSOLE_CLIENT_ID} \
    --dart-define=CONSOLE_REDIRECT_URI=${CONSOLE_REDIRECT_URI}

FROM nginx:1.27-alpine
ARG SALES_BASE_PATH=
# nginx renders the template at start using $SALES_BASE_PATH (see compose env).
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
# Serve the bundle from a dir matching the prefix, so plain `root` (not alias)
# resolves /sales/main.dart.js → html/sales/main.dart.js.
COPY --from=build /app/build/web /usr/share/nginx/html${SALES_BASE_PATH}
EXPOSE 80
