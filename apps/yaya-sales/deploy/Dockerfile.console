# yaya-sales admin console — Flutter web build served by nginx.
# Build context: apps/yaya-sales/
#
# The console calls the sales API and the yaya-identity token endpoint
# cross-origin, so BOTH backends must allow its origin:
#   yaya-sales:    YAYA_SALES_CORS_ALLOWED_ORIGINS=<console origin>
#   yaya-identity: YAYA_IDENTITY_CORS_ALLOWED_ORIGINS=<console origin>
FROM ghcr.io/cirruslabs/flutter:3.41.1 AS build
WORKDIR /app
COPY console/pubspec.yaml console/pubspec.lock ./
RUN flutter pub get
COPY console/ ./
ARG IDENTITY_BASE_URL
ARG SALES_API_BASE_URL
ARG CONSOLE_CLIENT_ID=yaya-console
ARG CONSOLE_REDIRECT_URI
RUN flutter build web --release \
    --dart-define=IDENTITY_BASE_URL=${IDENTITY_BASE_URL} \
    --dart-define=SALES_API_BASE_URL=${SALES_API_BASE_URL} \
    --dart-define=CONSOLE_CLIENT_ID=${CONSOLE_CLIENT_ID} \
    --dart-define=CONSOLE_REDIRECT_URI=${CONSOLE_REDIRECT_URI}

FROM nginx:1.27-alpine
COPY --from=build /app/build/web /usr/share/nginx/html
# SPA fallback: /callback and deep links must resolve to index.html.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri $uri/ /index.html; }\n}\n' \
    > /etc/nginx/conf.d/default.conf
EXPOSE 80
